+int SSL_set_write_cipher_list_override(SSL *ssl, const uint16_t *ciphers,
+                                       size_t num_ciphers) {
+  auto *ssl_impl = FromOpaque(ssl);
+  if (!ssl_impl->config) {
+    return 0;
+  }
+  return ssl_impl->config->client_cipher_list_override.CopyFrom(
+      Span(ciphers, num_ciphers));
+}
+
+int SSL_set_write_supported_versions_override(SSL *ssl,
+                                              const uint16_t *versions,
+                                              size_t num_versions) {
+  auto *ssl_impl = FromOpaque(ssl);
+  if (!ssl_impl->config) {
+    return 0;
+  }
+  return ssl_impl->config->client_supported_versions_override.CopyFrom(
+      Span(versions, num_versions));
+}
+
+void SSL_set_signature_algorithm_grease(SSL *ssl, int enabled) {
+  auto *ssl_impl = FromOpaque(ssl);
+  if (!ssl_impl->config) {
+    return;
+  }
+  ssl_impl->config->sigalg_grease = !!enabled;
+}
+
+void SSL_set_client_hello_padding(SSL *ssl, int enabled) {
+  auto *ssl_impl = FromOpaque(ssl);
+  if (!ssl_impl->config) {
+    return;
+  }
+  ssl_impl->config->client_hello_padding = !!enabled;
+}
